# Runtime state written by the Web UI
webui/scan_history.json
webui/memory_baseline.json
# The clean-machine baseline of the network analysis, and a write of either that
# did not finish (both are written by replacing a .tmp beside them)
webui/memory_baseline.json.tmp
webui/net_baseline.json
webui/net_baseline.json.tmp
# Hooks known on this host (syscall map), and the copy kept of one that could not be read
webui/syscall_hook_allowlist.json
webui/syscall_hook_allowlist.json.tmp
webui/syscall_hook_allowlist.json.corrupt
webui/memory_results/
webui/net_results/
webui/rizin_projects/
# A write of submissions.json that did not finish (the file itself is in the repository)
webui/submissions.json.tmp
# Own dashboards of the Dashboard tab (saved per lab, written by the web UI)
webui/dashboards.json
webui/dashboards.json.tmp

# Subagent-driven development scratch (ledger, briefs, review packages)
.superpowers/
# Pipe interception recordings
webui/pipe_sessions/
# LOGS tab persisted access/MCP logs
webui/logs/
# Locally built test samples (source only is committed)
tests/samples/*.exe
tests/samples/*.pdb

# FIREWALL tab state: decisions, captures, settings (the samples themselves are in C:\tdc\samples)
webui/pending.json
webui/pending.json.tmp
webui/captures.json
webui/captures.json.tmp
webui/firewall_state.json
webui/firewall_state.json.tmp

# Tool update state
webui/tool_updates_state.json
webui/tool_updates_state.json.tmp
webui/tool-updates.log

# Fake internet: the thumbprint of the session CA while it may be in the machine store, and a write of it
# that did not finish (written by replacing a .tmp beside it)
webui/session_ca.json
webui/session_ca.json.tmp

# The offline wiki, built by `make docs` / `.\make.ps1 docs` from docs/
webui/static/wiki.html
webui/static/wiki.html.tmp
# The documentation website, built by `make site` / `.\make.ps1 site` from
# docs/ and README.md; the workflow builds it again and publishes that
/site/
